{
  "keybindings": {
    "Common": {
      "<Ctrl-c>": "Quit",
    },
    "KeySpace": {
      "j": "ScrollDown",
      "k": "ScrollUp",
      "r": "RefreshSpace",
      "n": "LoadNextPage",
      "p": "LoadPreviousPage",
      "f": "SetPattern",
      "l": "DeletePattern",
      "<Esc>": "ClosePopup",
      "<Enter>": "EnterValue",
      "d": "DeleteKey",
      "t": "SetTtl",
      "e": "EditValue",
      "a": "AddKey",
      "i": "AddItem",
      "s": "SelectDb",
      "m": "ToggleDashboard",
      "b": "TogglePubSub",
      "<Left>": "ScrollLeft",
      "<Right>": "ScrollRight",
      "w": "ToggleWrap",
      "y": "YankValue",
      "<Shift-y>": "YankKey",
      "<Shift-r>": "ToggleReadOnly",
      "o": "OpenSortMenu",
      "<Shift-t>": "TypeFilter",
      "v": "ToggleTree",
      "<Shift-a>": "LoadAll",
      "<g><o>": "GoToOpenKey",
      "<Tab>": "StreamTab",
      "<g><m>": "GoToMonitor",
      "<g><s>": "GoToSlowlog",
      "<g><p>": "GoToPubSub",
      "<g><d>": "GoToDashboard",
      "<F2>": "Rename",
      "c": "CopyKey",
      "<Space>": "ToggleMark",
      "<Shift-m>": "MarkAllVisible",
      "<Shift-u>": "ClearMarks",
      "<Shift-e>": "EditExternal",
      "?": "ToggleHelp",
    },
    "Dashboard": {
      "m": "ToggleDashboard",
      "<Esc>": "ToggleDashboard",
      "<Space>": "ToggleMetricsPause",
      "r": "ResetMetrics",
      "<Tab>": "NextNode",
      "<Right>": "NextChart",
      "l": "NextChart",
      "<BackTab>": "PrevNode",
      "<Left>": "PrevChart",
      "h": "PrevChart",
      "a": "ToggleAllCharts",
      "b": "TogglePubSub",
      "<g><m>": "GoToMonitor",
      "<g><s>": "GoToSlowlog",
      "<g><p>": "GoToPubSub",
      "<g><d>": "GoToDashboard",
      "<Shift-r>": "ToggleReadOnly",
      "?": "ToggleHelp",
    },
    "PubSub": {
      "b": "TogglePubSub",
      "<Esc>": "TogglePubSub",
      "j": "ScrollDown",
      "k": "ScrollUp",
      "<Down>": "ScrollDown",
      "<Up>": "ScrollUp",
      "a": "PubSubAdd",
      "d": "PubSubRemove",
      "c": "PubSubClear",
      "r": "PubSubRefresh",
      "<Shift-p>": "PubSubPublish",
      "<Shift-n>": "PubSubToggleNotify",
      "<Enter>": "PubSubEnter",
      "<Tab>": "PubSubFocus",
      "<Space>": "PubSubTogglePause",
      "y": "YankValue",
      "<Shift-y>": "YankKey",
      "w": "ToggleWrap",
      "<Left>": "ScrollLeft",
      "<Right>": "ScrollRight",
      "<g><m>": "GoToMonitor",
      "<g><s>": "GoToSlowlog",
      "<g><p>": "GoToPubSub",
      "<g><d>": "GoToDashboard",
      "<Shift-r>": "ToggleReadOnly",
      "?": "ToggleHelp",
    },
    "Monitor": {
      "<Esc>": "LeaveScreen",
      "t": "MonitorToggle",
      "/": "MonitorFilter",
      "<Space>": "MonitorTogglePause",
      "c": "MonitorClear",
      "<Enter>": "MonitorEnter",
      "<Tab>": "NextNode",
      "<BackTab>": "PrevNode",
      "j": "ScrollDown",
      "k": "ScrollUp",
      "<Down>": "ScrollDown",
      "<Up>": "ScrollUp",
      "w": "ToggleWrap",
      "<Left>": "ScrollLeft",
      "<Right>": "ScrollRight",
      "<g><m>": "GoToMonitor",
      "<g><s>": "GoToSlowlog",
      "<g><p>": "GoToPubSub",
      "<g><d>": "GoToDashboard",
      "<Shift-r>": "ToggleReadOnly",
      "?": "ToggleHelp",
    },
    "Slowlog": {
      "<Esc>": "LeaveScreen",
      "r": "SlowlogRefresh",
      "o": "SlowlogSort",
      "<Enter>": "SlowlogEnter",
      "<Tab>": "NextNode",
      "<BackTab>": "PrevNode",
      // Here R resets the slowlog (after a preview), not read-only.
      "<Shift-r>": "SlowlogReset",
      "j": "ScrollDown",
      "k": "ScrollUp",
      "<Down>": "ScrollDown",
      "<Up>": "ScrollUp",
      "w": "ToggleWrap",
      "<Left>": "ScrollLeft",
      "<Right>": "ScrollRight",
      "<g><m>": "GoToMonitor",
      "<g><s>": "GoToSlowlog",
      "<g><p>": "GoToPubSub",
      "<g><d>": "GoToDashboard",
      "?": "ToggleHelp",
    },
  },
  "colors": {
    "base00": "#282936",
    "base01": "#3a3c4e",
    "base02": "#4d4f68",
    "base03": "#626483",
    "base04": "#62d6e8",
    "base05": "#e9e9f4",
    "base06": "#f1f2f8",
    "base07": "#f7f7fb",
    "base08": "#ea51b2",
    "base09": "#b45bcf",
    "base0a": "#00f769",
    "base0b": "#ebff87",
    "base0c": "#a1efe4",
    "base0d": "#62d6e8",
    "base0e": "#b45bcf",
    "base0f": "#00f769",
    // Environment colours (footer badge, top line). Override them in your
    // own config's `colors`.
    "env_local": "#00f769",
    "env_staging": "#f1fa8c",
    "env_prod": "#ff5555",
    "env_unknown": "#ffb86c",
  },
  "keyspace": {
    "string": "#00f769",
    "hash": "#62d6e8",
    "list": "#ffb86c",
    "zset": "#ea51b2",
    "set": "#ebff87",
    "json": "#b45bcf",
    "stream": "#8be9fd",
    "unknown": "#f71638",
    // A RedisJSON document (or field) above this many bytes shows a preview
    // (its top-level fields, or the first 100 items) instead of the whole value.
    "json_preview_bytes": 1048576,
    // The tree view (v) groups key names at this separator.
    "separator": ":",
  },
  "live": {
    // How the open key follows changes made by other clients:
    // "auto" (CLIENT TRACKING on Redis 6+, else polling), "tracking",
    // "poll" or "off".
    "mode": "auto",
    // How often polling checks the open key, in milliseconds (250 or more).
    "poll_interval_ms": 2000,
  },
  "monitor": {
    // Lines and bytes kept on the MONITOR screen; the oldest go first.
    "buffer_lines": 10000,
    "buffer_bytes": 16777216,
    // Above this many lines per second, keep one line in N.
    "max_rate": 5000,
    // MONITOR costs the server CPU, so it stops when you leave the screen.
    "keep_running": false,
  }
}
