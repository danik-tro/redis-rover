{
  "keybindings": {
    "Common": {
      "<Ctrl-c>": "Quit",
    },
    "KeySpace": {
      "j": "ScrollDown",
      "k": "ScrollUp",
      "r": "RefreshSpace",
      "n": "LoadNextPage",
      "p": "LoadPreviousPage",
      "f": "SetPattern",
      "l": "DeletePattern",
      "<Esc>": "ClosePopup",
      "<Enter>": "EnterValue",
      "d": "DeleteKey",
      "t": "SetTtl",
      "e": "EditValue",
      "a": "AddKey",
      "i": "AddItem",
      "s": "SelectDb",
      "m": "ToggleDashboard",
      "b": "TogglePubSub",
      "<Left>": "ScrollLeft",
      "<Right>": "ScrollRight",
      "w": "ToggleWrap",
      "y": "YankValue",
      "<Shift-y>": "YankKey",
      "?": "ToggleHelp",
    },
    "Dashboard": {
      "m": "ToggleDashboard",
      "<Esc>": "ToggleDashboard",
      "<Space>": "ToggleMetricsPause",
      "r": "ResetMetrics",
      "<Tab>": "NextChart",
      "<Right>": "NextChart",
      "l": "NextChart",
      "<BackTab>": "PrevChart",
      "<Left>": "PrevChart",
      "h": "PrevChart",
      "a": "ToggleAllCharts",
      "b": "TogglePubSub",
      "?": "ToggleHelp",
    },
    "PubSub": {
      "b": "TogglePubSub",
      "<Esc>": "TogglePubSub",
      "j": "ScrollDown",
      "k": "ScrollUp",
      "<Down>": "ScrollDown",
      "<Up>": "ScrollUp",
      "a": "PubSubAdd",
      "d": "PubSubRemove",
      "c": "PubSubClear",
      "?": "ToggleHelp",
    },
  },
  "colors": {
    "base00": "#282936",
    "base01": "#3a3c4e",
    "base02": "#4d4f68",
    "base03": "#626483",
    "base04": "#62d6e8",
    "base05": "#e9e9f4",
    "base06": "#f1f2f8",
    "base07": "#f7f7fb",
    "base08": "#ea51b2",
    "base09": "#b45bcf",
    "base0a": "#00f769",
    "base0b": "#ebff87",
    "base0c": "#a1efe4",
    "base0d": "#62d6e8",
    "base0e": "#b45bcf",
    "base0f": "#00f769",
  },
  "keyspace": {
    "string": "#00f769",
    "hash": "#62d6e8",
    "list": "#ffb86c",
    "zset": "#ea51b2",
    "set": "#ebff87",
    "json": "#b45bcf",
    "stream": "#8be9fd",
    "unknown": "#f71638",
  }
}
